# ─── The Little Bookshop environment ──────────────────────────────────────
# Copy to .env.local and fill in. Server-only secrets must NEVER be prefixed
# with NEXT_PUBLIC_ (that prefix exposes values to the browser).

# Public base URL, used for the payment link in the customer's email. Defaults
# to the live site in production, so set this only for preview deployments.
PUBLIC_BASE_URL=http://localhost:3000

# ─── Order storage ──────────────────────────────────────────────────────────
# Postgres connection string (Neon, Supabase, or any Postgres). REQUIRED in
# production: serverless hosts give every request a fresh read-only filesystem,
# so the SQLite fallback there saves orders that are instantly unreachable and
# restarts the numbering on every instance. Use the POOLED connection string.
# Leave blank locally and the SQLite store in var/data is used instead.
DATABASE_URL=

# ─── Payments ───────────────────────────────────────────────────────────────
# There is no payment gateway. Customers transfer the total themselves by
# GCash or MariBank and send a screenshot on Instagram; the shop confirms each
# order by hand. Account numbers live in src/content/site.ts (PAYMENT_METHODS).

# ─── Email ──────────────────────────────────────────────────────────────────
# Every checkout emails the shop the full order (customer, address, items,
# totals) and emails the customer their order number and payment details.
# Those two messages are the order record, so this must work in production.
#
# The mailer is chosen from whichever credential is present: SMTP_HOST → smtp,
# RESEND_API_KEY → resend, neither → the dev outbox in var/outbox. Set
# EMAIL_PROVIDER only to override, e.g. to force `dev` on a staging deploy.
EMAIL_PROVIDER=

# Gmail: create an App Password (Google account → 2-Step Verification → App
# passwords) and paste the 16 characters into SMTP_PASS. Your normal Gmail
# password will not work. Roughly 500 messages a day, far above this shop.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=thelittlebookshop.ph.store@gmail.com
SMTP_PASS=

# Resend, once thelittlebookshop.store is verified with them. Its records go on
# a send. subdomain, so they do not disturb the domain's existing forwarding.
# Then EMAIL_FROM must be an address on that domain.
RESEND_API_KEY=

# Both default to the shop mailbox in src/content/site.ts; set only to change.
EMAIL_FROM=
ORDERS_EMAIL=

# ─── Shop settings ──────────────────────────────────────────────────────────
# Flat shipping charge in cents, shown in the cart and added at checkout.
# (Public by design: it's a display value; totals are recomputed server-side.)
NEXT_PUBLIC_FLAT_SHIPPING_CENTS=12000
# Orders at or above this subtotal ship free (centavos).
NEXT_PUBLIC_FREE_SHIPPING_MINIMUM_CENTS=99900

# SQLite order store location (point at a persistent volume in production)
ORDERS_DB_PATH=var/data/orders.sqlite
